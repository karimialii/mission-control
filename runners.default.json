{
  "claude": {
    "label": "Claude Code",
    "role": "executor",
    "model": "haiku",
    "models": [
      "claude-haiku-5-5",
      "claude-sonnet-5-5",
      "claude-opus-5-5",
      "claude-fable-5-1",
      "claude-haiku-4-5",
      "haiku",
      "sonnet",
      "opus"
    ],
    "parser": "claude",
    "timeout": 3600,
    "model_args": [
      "--model",
      "{model}"
    ],
    "cmd": [
      "claude",
      "-p",
      "{prompt}",
      "{model_args}",
      "{effort_args}",
      "{budget_args}",
      "--output-format",
      "stream-json",
      "--verbose",
      "--no-session-persistence",
      "--strict-mcp-config",
      "--disable-slash-commands",
      "--permission-mode",
      "acceptEdits",
      "--disallowedTools",
      "Bash(python3 -m pip*),Bash(pip *),Bash(npm install*)",
      "--allowedTools",
      "Read,Edit,Write,Glob,Grep,Bash(ls *),Bash(cat *),Bash(git status*),Bash(git diff*),Bash(npm test*),Bash(npm run test*),Bash(npm run build*),Bash(pytest*),Bash(python3 -m *),Bash(python -m *),Bash(npm run *)"
    ],
    "model_price": {
      "claude-haiku-5-5": 0.1,
      "haiku": 0.1,
      "claude-haiku-4-5": 1.0,
      "claude-sonnet-5-5": 2.0,
      "claude-sonnet-5": 2.0,
      "sonnet": 2.0,
      "claude-opus-5-5": 4.0,
      "opus": 4.0,
      "claude-opus-5": 5.0,
      "claude-opus-4-8": 5.0,
      "claude-fable-5-1": 10.0,
      "claude-fable-5": 10.0,
      "fable": 10.0
    },
    "efforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "effort_args": [
      "--effort",
      "{effort}"
    ],
    "budget_args": [
      "--max-budget-usd",
      "{budget}"
    ]
  },
  "codex": {
    "label": "Codex CLI",
    "role": "executor",
    "model": "",
    "models": [],
    "parser": "codex",
    "timeout": 3600,
    "model_args": [
      "-m",
      "{model}"
    ],
    "cmd": [
      "codex",
      "exec",
      "--json",
      "--sandbox",
      "workspace-write",
      "{model_args}",
      "{prompt}"
    ]
  },
  "gemini": {
